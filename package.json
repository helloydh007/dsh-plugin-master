{
  "name": "dsh-plugin-master",
  "version": "0.1.0",
  "private": true,
  "description": "Web plugin master for DeepSeek Harness: search, enable, disable, uninstall, group by system/user, with fuzzy search across name, repository, and loader entry ids.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/helloydh007/dsh-plugin-master.git"
  },
  "homepage": "https://github.com/helloydh007/dsh-plugin-master#readme",
  "bugs": {
    "url": "https://github.com/helloydh007/dsh-plugin-master/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin-manager",
    "plugin-master",
    "fuzzy-search",
    "web-ui"
  ],
  "type": "module",
  "main": "lib/index.mjs",
  "types": "lib/types/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./client": {
      "types": "./lib/types/client/index.d.mts",
      "default": "./lib/client.cjs"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.mts",
      "default": "./lib/invariant.mjs"
    },
    "./remote": {
      "types": "./lib/types/remote.d.mts",
      "default": "./lib/remote.js"
    },
    "./typert": {
      "types": "./lib/types/remote.d.mts",
      "default": "./lib/remote.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.mjs",
    "lib/client.cjs",
    "lib/invariant.mjs",
    "lib/remote.js",
    "lib/types",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-host.mjs && tsdown --config tsdown.client.config.ts",
    "build:host": "node scripts/build-host.mjs",
    "build:client": "tsdown --config tsdown.client.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-remotes": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6",
    "react": "^18.2.0"
  },
  "dependencies": {
    "yaml": "^2.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/dsh-api-remotes": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "esbuild": "^0.28.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
